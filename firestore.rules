rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dati dell'utente: solo lui li legge e li scrive.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Abbonamenti: l'utente li vede ma non può modificarli. Li scrive solo
    // il server dopo la verifica con Google Play, altrimenti chiunque
    // potrebbe attivarsi un piano da solo.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Contatori di utilizzo dell'IA: gestiti solo dal server.
    match /usage/{doc} {
      allow read, write: if false;
    }
  }
}
